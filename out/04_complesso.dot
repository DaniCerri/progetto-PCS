graph Circuito {
  layout=neato;
  splines=ortho;
  overlap=false;
  node [fontname="Helvetica"];
  edge [fontname="Helvetica", penwidth=1.4, arrowhead=none];
  // nodi del circuito
  n1 [shape=circle, style=filled, fillcolor=black, width=0.15, label="", xlabel="1"];
  n2 [shape=circle, style=filled, fillcolor=black, width=0.15, label="", xlabel="2"];
  n3 [shape=circle, style=filled, fillcolor=black, width=0.15, label="", xlabel="3"];
  n4 [shape=circle, style=filled, fillcolor=black, width=0.15, label="", xlabel="4"];
  n5 [shape=circle, style=filled, fillcolor=black, width=0.15, label="", xlabel="5"];
  n6 [shape=circle, style=filled, fillcolor=black, width=0.15, label="", xlabel="6"];
  // componenti
  c_V1 [shape=circle, style=filled, fillcolor=lightyellow, color=blue, fontcolor=blue, label="V1\n50V"];
  n1 -- c_V1 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_V1 -- n2 [taillabel="-", labelfontcolor=red, labeldistance=1.5];
  c_V2 [shape=circle, style=filled, fillcolor=lightyellow, color=blue, fontcolor=blue, label="V2\n30V"];
  n5 -- c_V2 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_V2 -- n4 [taillabel="-", labelfontcolor=red, labeldistance=1.5];
  c_R1 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R1\n10Ω"];
  n1 -- c_R1 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R1 -- n3;
  c_R2 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R2\n20Ω"];
  n1 -- c_R2 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R2 -- n4;
  c_R3 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R3\n5Ω"];
  n2 -- c_R3 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R3 -- n3;
  c_R4 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R4\n15Ω"];
  n2 -- c_R4 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R4 -- n5;
  c_R5 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R5\n25Ω"];
  n3 -- c_R5 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R5 -- n6;
  c_R6 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R6\n10Ω"];
  n5 -- c_R6 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R6 -- n6;
  c_R7 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R7\n30Ω"];
  n4 -- c_R7 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R7 -- n6;
  c_R8 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R8\n8Ω"];
  n2 -- c_R8 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R8 -- n6;
}
