graph Circuito {
  layout=neato;
  splines=ortho;
  overlap=false;
  node [fontname="Helvetica"];
  edge [fontname="Helvetica", penwidth=1.4, arrowhead=none];
  // nodi del circuito
  n1 [shape=circle, style=filled, fillcolor=black, width=0.15, label="", xlabel="1"];
  n2 [shape=circle, style=filled, fillcolor=black, width=0.15, label="", xlabel="2"];
  n3 [shape=circle, style=filled, fillcolor=black, width=0.15, label="", xlabel="3"];
  n4 [shape=circle, style=filled, fillcolor=black, width=0.15, label="", xlabel="4"];
  n5 [shape=circle, style=filled, fillcolor=black, width=0.15, label="", xlabel="5"];
  n6 [shape=circle, style=filled, fillcolor=black, width=0.15, label="", xlabel="6"];
  n7 [shape=circle, style=filled, fillcolor=black, width=0.15, label="", xlabel="7"];
  n8 [shape=circle, style=filled, fillcolor=black, width=0.15, label="", xlabel="8"];
  n9 [shape=circle, style=filled, fillcolor=black, width=0.15, label="", xlabel="9"];
  n10 [shape=circle, style=filled, fillcolor=black, width=0.15, label="", xlabel="10"];
  // componenti
  c_V1 [shape=circle, style=filled, fillcolor=lightyellow, color=blue, fontcolor=blue, label="V1\n80V"];
  n10 -- c_V1 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_V1 -- n1 [taillabel="-", labelfontcolor=red, labeldistance=1.5];
  c_V2 [shape=circle, style=filled, fillcolor=lightyellow, color=blue, fontcolor=blue, label="V2\n60V"];
  n10 -- c_V2 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_V2 -- n9 [taillabel="-", labelfontcolor=red, labeldistance=1.5];
  c_V3 [shape=circle, style=filled, fillcolor=lightyellow, color=blue, fontcolor=blue, label="V3\n40V"];
  n3 -- c_V3 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_V3 -- n5 [taillabel="-", labelfontcolor=red, labeldistance=1.5];
  c_R1 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R1\n2Ω"];
  n1 -- c_R1 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R1 -- n2;
  c_R2 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R2\n4Ω"];
  n2 -- c_R2 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R2 -- n3;
  c_R3 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R3\n6Ω"];
  n4 -- c_R3 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R3 -- n5;
  c_R4 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R4\n8Ω"];
  n5 -- c_R4 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R4 -- n6;
  c_R5 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R5\n10Ω"];
  n7 -- c_R5 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R5 -- n8;
  c_R6 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R6\n12Ω"];
  n8 -- c_R6 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R6 -- n9;
  c_R7 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R7\n3Ω"];
  n1 -- c_R7 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R7 -- n4;
  c_R8 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R8\n5Ω"];
  n4 -- c_R8 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R8 -- n7;
  c_R9 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R9\n7Ω"];
  n2 -- c_R9 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R9 -- n5;
  c_R10 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R10\n9Ω"];
  n5 -- c_R10 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R10 -- n8;
  c_R11 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R11\n11Ω"];
  n3 -- c_R11 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R11 -- n6;
  c_R12 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R12\n13Ω"];
  n6 -- c_R12 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R12 -- n9;
  c_R13 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R13\n5Ω"];
  n1 -- c_R13 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R13 -- n5;
  c_R14 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R14\n15Ω"];
  n5 -- c_R14 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R14 -- n9;
  c_R15 [shape=rectangle, style="filled,rounded", fillcolor=white, color=black, label="R15\n20Ω"];
  n7 -- c_R15 [headlabel="+", labelfontcolor=red, labeldistance=1.5];
  c_R15 -- n5;
}
